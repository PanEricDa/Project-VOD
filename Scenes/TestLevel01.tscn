[node name="MapBoundary" type="Node3D" parent="." unique_id=2096907163 groups=["testlevel01_navigation_geometry"]]
editor_description = "地图外轮廓空气墙。所有新增边界均归此节点；保持区域间斜坡与内部悬崖跳落通道开放。采用每段一个 StaticBody3D 和一个直接子 CollisionShape3D/BoxShape3D；无可见网格、无运行脚本。初始厚度 1.2 米，相邻端部各延伸 0.65 米；世界高度范围 -22 至 35 米。沿地形略向内收，防止角色触墙前踩空。World 第1层，Mask为空，沿用角色现有环境碰撞配置。编辑位置与Y旋转请选 Wall；编辑长度/高度/厚度请选其 CollisionShape3D > Shape > Size，X/Y/Z 单位为米，保持各节点 Scale=(1,1,1)。地形边缘调整后需同步墙段。"
visible = false

